{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/gerar_pix.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/verificar_pagamento.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/webhook_flevopay.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/webhook_winnerpay.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/webhook_pix.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/gateway_status.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/configurar_webhook.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/_debug_ssl.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.php"
    }
  ]
}